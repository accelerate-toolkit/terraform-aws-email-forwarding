{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>accelerate-toolkit/renovate-config"
  ],
  "timezone": "Europe/London",
  "schedule": [
    "before 6am on monday"
  ],
  "automerge": true,
  "prConcurrentLimit": 1,
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "groupName": "all dependencies",
      "groupSlug": "all-dependencies",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    }
  ],
  "pep723": {
    "managerFilePatterns": [
      "/^scripts/.*\\.py$/",
      "/^tests/.*\\.py$/",
      "/^examples/.*\\.py$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "APM_VERSION := (?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "apm-cli",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "RENOVATE_VERSION := (?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    }
  ],
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "ignoreTests": false,
  "ignorePaths": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/build/**",
    "**/apm_modules/**",
    "**/.agents/**",
    "**/.codex/**",
    "**/config.local.json"
  ]
}
